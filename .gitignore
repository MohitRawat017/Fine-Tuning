# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── Python bytecode / caches ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/

# ── Unsloth compiled caches (auto-generated, huge, machine-specific) ──
unsloth_compiled_cache/
**/unsloth_compiled_cache/

# ── Local secrets ─────────────────────────────────────────────────────
.env
.env.*
*.local

# ── Training outputs / checkpoints (any project) ──────────────────────
output/
**/output/
checkpoint-*/
**/checkpoint-*/
runs/
**/runs/
wandb/

# ── Fine-tuned model weights ──────────────────────────────────────────
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# ── FunctionGemma trained adapter (regenerable via train.py) ──────────
FunctionGemma/fg_finetuned_ckpt/

